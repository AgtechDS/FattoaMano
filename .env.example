# ==============================================================================
# FATTO A MANO - CONFIGURAZIONE CHIAVI & AMBIENTE (MODELLO TEMPLATE)
# ==============================================================================

# Porte & Server locale
PORT=8092

# Telegram Bot AGOS Bridge (ricezione foto & prompt catalogo)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_OWNER_ID=your_telegram_chat_id_here

# Supabase Cloud Database & Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=fattoamano-products

# Stripe Payments Gateway (Live o Test)
STRIPE_SECRET_KEY=sk_live_or_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_live_or_test_key_here
