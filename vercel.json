{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/atelier-pietre", "destination": "/atelier-pietre.html" },
    { "source": "/atelier-pietre/", "destination": "/atelier-pietre.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/success", "destination": "/success.html" },
    { "source": "/success/", "destination": "/success.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ]
}
